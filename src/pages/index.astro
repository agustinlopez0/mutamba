---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import QueEs from '../components/QueEs.astro';
import Clases from '../components/Clases.astro';
import Historias from '../components/Historias.astro';
import Encuentro from '../components/Encuentro.astro';
import Profes from '../components/Profes.astro';
import Sedes from '../components/Sedes.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
---

<Base
  title="Clases de capoeira en Rosario · Mutamba Capoeira Rosario"
  description="Clases de capoeira en Rosario para chicos de 8 a 14 años, adultos y adultos mayores, en Pte. Roca 1436 y Mendoza 5395. La primera clase es gratis."
>
  <Header />
  <main>
    <Hero />
    <Clases />
    <Profes />
    <QueEs />
    <Historias />
    <Encuentro />
    <Sedes />
    <Faq />
    <CtaFinal />
  </main>
  <Footer />
  <WhatsAppFlotante />
</Base>
