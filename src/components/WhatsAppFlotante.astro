---
import Icon from './Icon.astro';
import { waLink } from '../data/site';
---

<a class="wa-float" href={waLink('general')} target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp" data-wa-float>
  <Icon name="whatsapp" />
</a>

<style>
  .wa-float {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 999px;
    background: var(--wa);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
    transform: translateY(120px);
    transition:
      transform 0.3s ease,
      background-color 0.15s ease;
  }
  .wa-float.is-visible {
    transform: none;
  }
  .wa-float:hover {
    background: var(--wa-hover);
  }
  .wa-float :global(svg) {
    width: 28px;
    height: 28px;
  }
</style>

<script>
  // Aparece cuando el hero ya no está a la vista y se esconde al llegar a Contacto y al footer,
  // que ya tienen sus propios botones de WhatsApp.
  const btn = document.querySelector<HTMLElement>('[data-wa-float]')!;
  const zonas = [document.getElementById('top'), document.getElementById('contacto'), document.querySelector('footer')].filter(
    (z): z is HTMLElement => !!z,
  );
  if (zonas.length && 'IntersectionObserver' in window) {
    const enVista = new Set<Element>();
    const io = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) enVista.add(e.target);
          else enVista.delete(e.target);
        }
        btn.classList.toggle('is-visible', enVista.size === 0);
      },
      { threshold: 0.15 },
    );
    zonas.forEach((z) => io.observe(z));
  } else {
    btn.classList.add('is-visible');
  }
</script>
