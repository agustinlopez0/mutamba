---
// La corda del cero de la página 404: dos vueltas de soga a la cintura, el nudo al costado y las dos puntas
// colgando con su fleco. Va dentro del SVG de AuDelCero, en coordenadas del cero (centro en 0, 0; pies en y = 75).
// Los colores están en el <style>, en un solo lugar.
type Punto = [number, number];
type Curva = [Punto, Punto, Punto, Punto];

const redondear = (n: number) => Math.round(n * 10) / 10;

// Una soga a partir de una curva: el trazo y las rayitas inclinadas del torcido.
function soga(curva: Curva, ancho: number, paso = 4.8) {
  const [a, b, c, d] = curva;
  const en = (t: number, k: 0 | 1) => {
    const u = 1 - t;
    return u ** 3 * a[k] + 3 * u * u * t * b[k] + 3 * u * t * t * c[k] + t ** 3 * d[k];
  };
  const PASOS = 120;
  const largo = Array.from({ length: PASOS }, (_, i) =>
    Math.hypot(en((i + 1) / PASOS, 0) - en(i / PASOS, 0), en((i + 1) / PASOS, 1) - en(i / PASOS, 1)),
  ).reduce((suma, tramo) => suma + tramo, 0);
  const alto = ancho * 0.42;
  const inclinacion = ancho * 0.26;
  let torcido = '';
  let recorrido = 0;
  let proxima = paso * 0.6;
  for (let i = 1; i <= PASOS; i++) {
    const [x, y] = [en(i / PASOS, 0), en(i / PASOS, 1)];
    const [dx, dy] = [x - en((i - 1) / PASOS, 0), y - en((i - 1) / PASOS, 1)];
    const tramo = Math.hypot(dx, dy);
    recorrido += tramo;
    // (sin llegar a los extremos, para que las rayitas no asomen fuera de la soga)
    if (recorrido < proxima || recorrido > largo - paso * 0.6) continue;
    proxima += paso;
    const [tx, ty] = [dx / tramo, dy / tramo];
    const desde = [x + ty * alto - tx * inclinacion, y - tx * alto - ty * inclinacion].map(redondear);
    const hasta = [x - ty * alto + tx * inclinacion, y + tx * alto + ty * inclinacion].map(redondear);
    torcido += `M${desde.join(' ')}L${hasta.join(' ')}`;
  }
  return { trazo: `M${a.join(' ')}C${b.join(' ')} ${c.join(' ')} ${d.join(' ')}`, torcido, ancho };
}

// El fleco con que termina cada punta: los hilos se abren desde la atadura.
function fleco([x, y]: Punto) {
  const LARGO = 21;
  const largos = [0.8, 0.95, 0.88, 1.05, 0.96, 1.02, 0.9, 0.98, 0.78];
  const p = (dx: number, dy: number) => `${redondear(x + dx)} ${redondear(y + dy * LARGO)}`;
  return {
    fondo: `M${p(-3, 0)}Q${p(-6, 0.4)} ${p(-6.6, 0.8)}L${p(6.6, 0.8)}Q${p(6, 0.4)} ${p(3, 0)}Z`,
    hilos: largos.map((largo, i) => {
      const abre = (i - 4) * 1.6;
      return `M${p(abre * 0.45, 0)}Q${p(abre, 0.42)} ${p(abre + (i % 2 ? 0.9 : -0.6), largo)}`;
    }),
    atadura: `M${p(-3.1, 0)}H${redondear(x + 3.1)}`,
  };
}

const ANCHO = 7.6;

const vueltas = [
  soga([[-47, -10.5], [-30, -8], [30, -8], [47, -10.5]], ANCHO),
  soga([[-47, 0.9], [-30, 3.4], [30, 3.4], [47, 0.9]], ANCHO),
];

// `origen`: de dónde cuelga cada punta. `peso`: cuánto se sacude (la más larga, más).
const puntas = [
  { origen: [-27, 6], peso: 0.7, curva: [[-27, 6], [-24, 16], [-25.5, 26], [-24.5, 38]] as Curva },
  { origen: [-34, 6], peso: 1, curva: [[-34, 6], [-38, 22], [-34.5, 34], [-36, 50]] as Curva },
].map((p) => ({ ...p, soga: soga(p.curva, ANCHO - 0.6), fleco: fleco(p.curva[3]) }));

const nudo = [
  soga([[-24, -16], [-38, -18], [-43, 1], [-31, 7]], ANCHO + 0.4),
  soga([[-37, -11], [-31, -15], [-22, -6], [-26, 10]], ANCHO + 1.4),
];
---

<g class="corda">
  {
    vueltas.map((s) => (
      <g style={`--ancho: ${s.ancho}px`}>
        <path class="corda__borde" d={s.trazo} />
        <path class="corda__soga" d={s.trazo} />
        <path class="corda__torcido" d={s.torcido} />
      </g>
    ))
  }
  {
    puntas.map((p) => (
      <g
        class="corda__punta"
        style={`--ancho: ${p.soga.ancho}px; transform-origin: ${p.origen[0]}px ${p.origen[1]}px`}
        data-punta={p.peso}
      >
        <path class="corda__borde" d={p.soga.trazo} />
        <path class="corda__soga" d={p.soga.trazo} />
        <path class="corda__torcido" d={p.soga.torcido} />
        <path class="corda__fondo" d={p.fleco.fondo} />
        {p.fleco.hilos.map((d, i) => (
          <path class:list={['corda__hilo', `corda__hilo--${i % 3}`]} d={d} />
        ))}
        <path class="corda__atadura corda__atadura--borde" d={p.fleco.atadura} />
        <path class="corda__atadura" d={p.fleco.atadura} />
      </g>
    ))
  }
  {
    nudo.map((s) => (
      <g class="corda__nudo" style={`--ancho: ${s.ancho}px`}>
        <path class="corda__borde" d={s.trazo} />
        <path class="corda__soga" d={s.trazo} />
        <path class="corda__torcido" d={s.torcido} />
      </g>
    ))
  }
</g>

<style>
  .corda {
    --corda: var(--red);
    --corda-luz: #f0483b;
    --corda-sombra: #a3170c;
    --corda-borde: #8f130a;
    fill: none;
  }
  .corda__borde {
    stroke: var(--corda-borde);
    stroke-width: calc(var(--ancho) + 1.8px);
  }
  .corda__soga {
    stroke: var(--corda);
    stroke-width: var(--ancho);
  }
  .corda__nudo .corda__borde,
  .corda__nudo .corda__soga {
    stroke-linecap: round;
  }
  .corda__torcido {
    stroke: var(--corda-sombra);
    stroke-width: 1.1px;
    stroke-linecap: round;
  }
  .corda__punta {
    transform-box: view-box;
  }
  .corda__fondo {
    fill: var(--corda-borde);
  }
  .corda__hilo {
    stroke: var(--corda);
    stroke-width: 1.9px;
    stroke-linecap: round;
  }
  .corda__hilo--0 {
    stroke: var(--corda-sombra);
  }
  .corda__hilo--2 {
    stroke: var(--corda-luz);
  }
  .corda__atadura {
    stroke: var(--corda-luz);
    stroke-width: 3.2px;
    stroke-linecap: round;
  }
  .corda__atadura--borde {
    stroke: var(--corda-borde);
    stroke-width: 5.2px;
  }
</style>
