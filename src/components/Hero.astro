---
import Foto from './Foto.astro';
import Icon from './Icon.astro';
import { sedes, waLink } from '../data/site';
---

<section class="hero" id="top">
  <Foto
    nombre="hero-roda-acrobacia"
    alt="Dos capoeiristas en pleno salto dentro de la roda de Mutamba Rosario"
    sizes="100vw"
    widths={[640, 960, 1280, 1600, 2000]}
    class="hero__img"
    priority
  />
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="container hero__content" id="contenido">
    <h1 class="hero__title">Capoeira en Rosario</h1>
    <p class="hero__lead">
      Clases para chicos, adultos y adultos mayores, en dos sedes: {sedes.roca.direccion} y {sedes.mendoza.direccion}.
      Si nunca hiciste capoeira, vení a probar: la primera clase es gratis.
    </p>
    <div class="hero__actions">
      <a class="btn btn--wa" href={waLink('general')} target="_blank" rel="noopener">
        <Icon name="whatsapp" />
        Escribinos por WhatsApp
      </a>
      <a class="btn btn--ghost" href="#clases">
        Ver horarios
        <Icon name="arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(92svh, 860px);
    display: grid;
    align-items: end;
    color: #fff;
    background: var(--night);
    isolation: isolate;
    overflow: hidden;
  }
  .hero :global(picture) {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }
  .hero :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 35%;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(18 16 16 / 0.75) 0, rgb(18 16 16 / 0) 190px),
      linear-gradient(90deg, rgb(18 16 16 / 0.9) 0%, rgb(18 16 16 / 0.65) 45%, rgb(18 16 16 / 0.1) 78%),
      linear-gradient(0deg, rgb(18 16 16 / 0.8) 0%, transparent 40%);
  }
  .hero__content {
    padding-top: calc(var(--header-h) + 48px);
    padding-bottom: clamp(56px, 9vw, 104px);
  }
  .hero__title {
    font-size: clamp(3.2rem, 10vw, 7rem);
    line-height: 0.92;
    max-width: 9ch;
  }
  .hero__lead {
    margin-top: 22px;
    max-width: 44ch;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: rgb(255 255 255 / 0.9);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  /* Entrada al cargar: la foto se asienta y el texto sube de a una línea. */
  @keyframes asentar {
    from {
      transform: scale(1.06);
    }
  }
  @keyframes subir {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  :global(.js) .hero :global(.hero__img) {
    animation: asentar 1.8s var(--ease-out) both;
  }
  :global(.js) .hero__content > * {
    animation: subir 0.9s var(--ease-out) both;
  }
  :global(.js) .hero__content > :nth-child(2) {
    animation-delay: 0.1s;
  }
  :global(.js) .hero__content > :nth-child(3) {
    animation-delay: 0.2s;
  }
  /* celular: la foto arriba, entera, y el texto abajo sobre fondo oscuro */
  @media (max-width: 720px) {
    .hero {
      display: block;
      min-height: 0;
    }
    .hero :global(picture) {
      position: relative;
      inset: auto;
      display: block;
    }
    .hero :global(.hero__img) {
      height: auto;
      aspect-ratio: 4 / 3;
      object-position: 55% center;
    }
    .hero__shade {
      inset: 0 0 auto;
      aspect-ratio: 4 / 3;
      background: linear-gradient(
        180deg,
        rgb(18 16 16 / 0.7) 0%,
        rgb(18 16 16 / 0) 32%,
        rgb(18 16 16 / 0) 55%,
        var(--night) 100%
      );
    }
    .hero__content {
      margin-top: -52px;
      padding-top: 0;
      padding-bottom: 56px;
    }
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
