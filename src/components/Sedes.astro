---
import Icon from './Icon.astro';
import { clases, sedes, mapsLink, mapsEmbed } from '../data/site';
import type { SedeId } from '../data/site';

const lista = (Object.keys(sedes) as SedeId[]).map((id) => ({
  ...sedes[id],
  grupos: clases.filter((c) => c.sede === id).map((c) => c.titulo),
}));
---

<section class="section sedes" id="sedes">
  <div class="container">
    <h2 class="section-title" data-reveal>Sedes</h2>

    <div class="sedes__grid">
      {
        lista.map((s) => (
          <article class="sede" data-reveal>
            <div class="sede__head">
              <div>
                <h3>{s.direccion}</h3>
                <p>{s.grupos.join(' · ')}</p>
              </div>
              <a class="sede__link" href={mapsLink(s.id)} target="_blank" rel="noopener">
                Cómo llegar
                <Icon name="arrow" />
              </a>
            </div>
            <div class="sede__mapa">
              <iframe
                src={mapsEmbed(s.id)}
                title={`Mapa: ${s.direccion}, Rosario`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sedes {
    background: var(--paper-2);
  }
  .sedes__grid {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 48px);
  }
  .sede {
    padding-top: 22px;
    border-top: 2px solid var(--ink);
  }
  .sede__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }
  .sede h3 {
    font-size: clamp(1.9rem, 3.2vw, 2.5rem);
  }
  .sede__head p {
    margin-top: 6px;
    color: var(--ink-2);
  }
  .sede__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    padding-block: 8px;
    font-weight: 700;
    color: var(--red-deep);
    text-decoration: none;
    white-space: nowrap;
  }
  .sede__link :global(svg) {
    width: 18px;
    height: 18px;
    transition: transform 0.25s var(--ease-out);
  }
  .sede__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sede__link:hover :global(svg) {
    transform: translateX(3px);
  }
  .sede__mapa {
    margin-top: 18px;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--paper);
  }
  .sede__mapa iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.3);
  }

  @media (max-width: 700px) {
    .sedes__grid {
      grid-template-columns: 1fr;
    }
    .sede__mapa {
      aspect-ratio: 1 / 1;
    }
  }
</style>
