---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Foto from './Foto.astro';
import Icon from './Icon.astro';
import { clases, sedes, mapsLink } from '../data/site';
import type { SedeId } from '../data/site';

// Por sede: la foto de la entrada (src/assets/fotos/sede-<id>.jpg) y un mapa (src/assets/mapas/<id>.png),
// armado con OpenStreetMap y centrado en la dirección (por eso el pin va en el medio).
// Al tocar el mapa se abre Google Maps, igual que con "Cómo llegar".
const mapas = import.meta.glob<{ default: ImageMetadata }>('../assets/mapas/*.png', { eager: true });

const lista = (Object.keys(sedes) as SedeId[]).map((id) => ({
  ...sedes[id],
  grupos: clases.filter((c) => c.sede === id).map((c) => c.titulo),
  mapa: mapas[`../assets/mapas/${id}.png`]?.default,
}));
---

<section class="section sedes" id="sedes">
  <div class="container">
    <h2 class="section-title" data-reveal>Sedes</h2>

    <div class="sedes__lista">
      {
        lista.map((s) => (
          <article class="sede" data-reveal>
            <div class="sede__info">
              <h3>{s.direccion}</h3>
              <p class="sede__lugar">
                En <strong>{s.lugar}</strong>, {s.rubro}
              </p>
              <p class="sede__grupos">{s.grupos.join(' · ')}</p>
              <a class="sede__link" href={mapsLink(s.id)} target="_blank" rel="noopener">
                Cómo llegar
                <Icon name="arrow" />
              </a>
            </div>

            <div class="sede__media">
              <figure class="sede__foto">
                <Foto
                  nombre={`sede-${s.id}`}
                  alt={`El frente de ${s.lugar}, en ${s.direccion}`}
                  sizes="(max-width: 700px) 85vw, (max-width: 1000px) 45vw, 340px"
                  widths={[340, 500, 680]}
                  class="sede__img"
                />
                <figcaption class="sede__chip">El frente</figcaption>
              </figure>
              {s.mapa && (
                <div class="sede__mapa">
                  {/* Lleva al mismo lugar que "Cómo llegar", que es el link que usan el teclado y los lectores de pantalla. */}
                  <a class="sede__abrir" href={mapsLink(s.id)} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                    <Image src={s.mapa} alt="" format="webp" quality={85} class="sede__img" />
                    <svg class="sede__pin" viewBox="0 0 32 42">
                      <path d="M16 41s-13-12.2-13-23.5a13 13 0 0 1 26 0C29 28.8 16 41 16 41z" />
                      <circle cx="16" cy="17.5" r="5" />
                    </svg>
                  </a>
                  <a class="sede__chip sede__osm" href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">
                    © OpenStreetMap
                  </a>
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sedes {
    background: var(--paper-2);
  }
  .sedes__lista {
    margin-top: 40px;
    display: grid;
    gap: clamp(40px, 5vw, 56px);
  }
  /* compu: los datos a la izquierda; la foto de la entrada y el mapa a la derecha */
  .sede {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px clamp(24px, 4vw, 48px);
    padding-top: 22px;
    border-top: 2px solid var(--ink);
  }
  .sede h3 {
    font-size: clamp(1.9rem, 3.2vw, 2.5rem);
  }
  .sede__lugar {
    margin-top: 10px;
  }
  .sede__grupos {
    margin-top: 2px;
    color: var(--ink-2);
  }
  .sede__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    padding-block: 8px;
    font-weight: 700;
    color: var(--red-deep);
    text-decoration: none;
  }
  .sede__link :global(svg) {
    width: 18px;
    height: 18px;
    transition: transform 0.25s var(--ease-out);
  }
  .sede__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sede__link:hover :global(svg) {
    transform: translateX(3px);
  }

  .sede__media {
    display: grid;
    grid-template-columns: repeat(2, clamp(260px, 27vw, 340px));
    gap: 12px;
  }
  .sede__foto,
  .sede__mapa {
    position: relative;
    margin: 0;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #e4dccf;
  }
  .sede__foto :global(picture) {
    display: block;
    height: 100%;
  }
  .sede__media :global(.sede__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sede__abrir {
    position: absolute;
    inset: 0;
  }
  .sede__abrir :global(.sede__img) {
    transition: transform 0.6s var(--ease-out);
  }
  .sede__abrir:hover :global(.sede__img) {
    transform: scale(1.03);
  }
  /* la punta del pin queda justo en el centro, que es donde está la dirección */
  .sede__pin {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 36px;
    height: auto;
    overflow: visible;
    transform: translate(-50%, -100%);
    filter: drop-shadow(0 4px 5px rgb(20 18 16 / 0.35));
    transition: transform 0.3s var(--ease-out);
  }
  .sede__abrir:hover .sede__pin {
    transform: translate(-50%, calc(-100% - 4px));
  }
  .sede__pin path {
    fill: var(--red);
    stroke: #fff;
    stroke-width: 2;
  }
  .sede__pin circle {
    fill: #fff;
  }
  .sede__chip {
    position: absolute;
    bottom: 8px;
    left: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgb(247 243 236 / 0.88);
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .sede__osm {
    left: auto;
    right: 8px;
    font-weight: 400;
    text-decoration: none;
  }
  .sede__osm:hover {
    text-decoration: underline;
  }

  /* tablet: los datos arriba y las dos imágenes abajo, una al lado de la otra */
  @media (max-width: 1000px) {
    .sede {
      grid-template-columns: minmax(0, 1fr);
    }
    .sede__media {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* celular: la foto y el mapa en una tira que se desliza de costado */
  @media (max-width: 700px) {
    .sede__media {
      display: flex;
      gap: 10px;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .sede__media::-webkit-scrollbar {
      display: none;
    }
    .sede__media > * {
      flex: 0 0 85%;
      scroll-snap-align: start;
    }
  }
</style>
