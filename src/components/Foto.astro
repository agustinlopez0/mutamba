---
// Carga una foto de src/assets/fotos por nombre y la sirve optimizada (AVIF/WebP, varios anchos).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  nombre: string;
  alt: string;
  sizes: string;
  widths?: number[];
  class?: string;
  priority?: boolean;
}

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.jpg', { eager: true });
const { nombre, alt, sizes, widths = [480, 800, 1200, 1600], class: className, priority = false } = Astro.props;

const mod = fotos[`../assets/fotos/${nombre}.jpg`];
if (!mod) throw new Error(`Foto no encontrada: ${nombre}`);
const src = mod.default;
const usable = widths.filter((w) => w <= src.width);
---

<Picture
  src={src}
  alt={alt}
  sizes={sizes}
  widths={usable.length ? usable : [src.width]}
  formats={['avif', 'webp']}
  class={className}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
  quality={72}
/>
